{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadTheArtifact",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::descon-mps-deploy-artifacts/web/*"
    },
    {
      "Sid": "StartOnlyThisDeployDocumentOnThisInstance",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:ap-southeast-1:304019241192:document/DesconDeployWeb",
        "arn:aws:ec2:ap-southeast-1:304019241192:instance/i-0834da05a4ff8aefe"
      ]
    },
    {
      "Sid": "ReadTheResultOfADeploy",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:ListCommandInvocations"
      ],
      "Resource": "*"
    }
  ]
}
