{
	"cli": {
		"version": ">= 15.0.15",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"EXPO_USE_PRECOMPILED_MODULES": "0"
			}
		},
		"preview": {
			"distribution": "internal",
			"android": {
				"buildType": "apk"
			},
			"env": {
				"EXPO_USE_PRECOMPILED_MODULES": "0",
				"EXPO_PUBLIC_API_BASE_URL": "https://descon-mps.com/api/v1"
			}
		},
		"production": {
			"autoIncrement": true,
			"android": {
				"buildType": "app-bundle"
			},
			"env": {
				"EXPO_USE_PRECOMPILED_MODULES": "0",
				"EXPO_PUBLIC_API_BASE_URL": "https://descon-mps.com/api/v1"
			}
		}
	},
	"submit": {
		"production": {
			"android": {
				"serviceAccountKeyPath": "./google-service-account.json",
				"track": "internal",
				"releaseStatus": "draft",
				"changesNotSentForReview": false
			}
		}
	}
}
